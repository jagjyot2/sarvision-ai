# SARVision Runtime Configuration
SARVISION_APP_NAME=SARVision AI
SARVISION_ENV=production
SARVISION_HOST=127.0.0.1
SARVISION_PORT=8000

# Database
SARVISION_DB_URL=sqlite:///./sarvision.db

# Model & Inference Defaults
SARVISION_MODEL_DIR=./models
SARVISION_ONNX_MODEL=sarvision_micro_detector.onnx
SARVISION_TILE_SIZE=640
SARVISION_TILE_OVERLAP=0.20
SARVISION_CONF_THRESHOLD=0.45
SARVISION_NMS_IOU_THRESHOLD=0.40
SARVISION_DETECTOR_MODE=fusion

# Camera / EXIF Fallback Defaults (used when image lacks EXIF altitude/FOV/pitch)
SARVISION_DEFAULT_AGL_METERS=120.0
SARVISION_DEFAULT_GIMBAL_PITCH_DEG=-90.0
SARVISION_DEFAULT_HFOV_DEG=64.0
SARVISION_DEFAULT_HEADING_DEG=0.0
